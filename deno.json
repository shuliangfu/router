{
  "name": "@dreamer/router",
  "version": "1.0.11",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./client": "./src/client/mod.ts"
  },
  "exclude": [
    "tests/data/**"
  ],
  "publish": {
    "include": [
      "src/mod.ts",
      "src/client/mod.ts",
      "src/client/components.ts",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**"
    ]
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@dreamer/test": "jsr:@dreamer/test@^1.0.6",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.0.7",
    "@dreamer/esbuild": "jsr:@dreamer/esbuild@^1.0.26"
  },
  "nodeModulesDir": "auto"
}
